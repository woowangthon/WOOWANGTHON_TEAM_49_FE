# Public API origin and version prefix. No secrets belong in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Development only. Default OFF; restart dev after changing.
NEXT_PUBLIC_MOCK_API=false

# Deployment-wide UI locale. Add a complete src/messages/<locale> pack, then rebuild.
NEXT_PUBLIC_APP_LOCALE=ko
